# Chave criada em https://aistudio.google.com (nunca envie para o GitHub)
GEMINI_API_KEY=cole-sua-chave-aqui

# Frase secreta para os cookies (qualquer texto longo)
SECRET_KEY=troque-por-uma-frase-secreta-longa

# Opcional: escolher o modelo manualmente (por padrão o app escolhe o "flash" mais novo disponível)
# GEMINI_MODELO=
# GEMINI_EMBEDDING=gemini-embedding-2

# Opcional: limites de uso
# MAX_MB=10
# MAX_PAGINAS=100
# MAX_DOCUMENTOS=5
# PERGUNTAS_POR_HORA=30
# USO_TOTAL_POR_DIA=500
